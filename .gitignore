# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/
.ipynb_checkpoints/

# ── Native build artifacts ───────────────────────────────
*.exe
*.o
*.obj
*.dll
cgal_remesh/build/
cgal_remesh/*.exe

# …but DO ship the prebuilt Windows binaries the installer bundles.
!bin/win64/
!bin/win64/*.exe
!bin/win64/*.dll

# PyInstaller work dirs
installer/build/
installer/dist/
installer/*.spec.bak

# ── CGAL headers (downloaded, header-only ~200 MB) ───────
CGAL-*/
*.tar.xz

# ── Data / intermediates (never committed — machine-local) ─
*.npy
*.inr
*.mesh
*.vtk
*.node
*.elem
*.png
save_data/
CRI_Data/

# ── Doxygen output ───────────────────────────────────────
docs/html/
docs/latex/
docs/xml/

# ── OS / editor ──────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
installer/payload/
